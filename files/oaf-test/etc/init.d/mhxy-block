#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

TABLE="mhxy_block"

. /lib/functions.sh

valid_ipv4() {
	local address="$1"
	local old_ifs="$IFS"
	local octet

	case "$address" in
		''|*[!0-9.]*|.*|*.|*..*)
			return 1
			;;
	esac

	IFS='.'
	set -- $address
	IFS="$old_ifs"

	[ "$#" -eq 4 ] || return 1
	for octet in "$@"; do
		case "$octet" in
			''|*[!0-9]*) return 1 ;;
		esac
		[ "$octet" -le 255 ] 2>/dev/null || return 1
	done
}

remove_rules() {
	if nft list table inet "$TABLE" >/dev/null 2>&1; then
		nft delete table inet "$TABLE"
	fi
}

start_service() {
	local enabled
	local device_ip

	remove_rules
	config_load mhxy_block
	config_get_bool enabled main enabled 0
	config_get device_ip main device_ip ""

	[ "$enabled" -eq 1 ] || return 0

	if ! valid_ipv4 "$device_ip"; then
		logger -t mhxy-block "invalid target IPv4 address: $device_ip"
		return 1
	fi

	if ! nft add table inet "$TABLE" ||
	   ! nft "add chain inet $TABLE forward { type filter hook forward priority -10; policy accept; }" ||
	   ! nft "add rule inet $TABLE forward ip saddr $device_ip ip daddr 42.186.0.0/16 tcp dport { 80, 443, 8888, 10627, 12104, 25003 } counter drop" ||
	   ! nft "add rule inet $TABLE forward ip saddr $device_ip ip daddr { 60.188.233.47, 115.236.122.174, 115.236.122.175, 140.249.240.49, 180.213.183.49, 223.252.201.98 } tcp dport 443 counter drop" ||
	   ! nft "add rule inet $TABLE forward ip saddr $device_ip ip daddr 35.220.226.90 tcp dport 5000 counter drop"; then
		remove_rules
		logger -t mhxy-block "failed to install nftables rules"
		return 1
	fi

	logger -t mhxy-block "test rules enabled for $device_ip"
}

stop_service() {
	remove_rules
}

reload_service() {
	stop_service
	start_service
}

service_triggers() {
	procd_add_reload_trigger mhxy_block
}
