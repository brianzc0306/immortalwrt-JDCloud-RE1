#!/bin/sh

# NSS/ECM is the forwarding fast path. Do not stack firewall flow offloading
# on top of it, especially while Nikki relies on nftables marks and TProxy.
if uci -q get firewall.@defaults[0] > /dev/null; then
	uci -q set firewall.@defaults[0].flow_offloading='0'
	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	uci -q commit firewall
fi

# Nikki writes its own files under /var/log, which is RAM-backed on OpenWrt.
# Keep warning-level core logs and cap each log at 1 MB.
if uci -q get nikki.log > /dev/null; then
	uci -q set nikki.mixin.log_level='warning'
	uci -q set nikki.log.clear_at_stop='1'
	uci -q set nikki.log.scheduled_clear='1'
	uci -q set nikki.log.scheduled_clear_cron='*/5 * * * *'
	uci -q set nikki.log.scheduled_clear_size_limit='1'
	uci -q set nikki.log.scheduled_clear_size_limit_unit='MB'
	uci -q commit nikki
fi

# The package patch makes this switch suppress Lucky's duplicate init messages.
# Lucky's application log remains a bounded in-memory ring buffer.
if uci -q get lucky.@lucky[0] > /dev/null; then
	uci -q set lucky.@lucky[0].logger='0'
	uci -q commit lucky
fi

/etc/init.d/re-cs-07-monitor enable

exit 0
